# =====================================================================
# Neptune AI (N-agent) — Backend Environment Configuration
# =====================================================================

# NEAR Cloud AI Configuration
NEAR_AI_API_KEY=""
NEAR_AI_MODEL="z-ai/glm-5.3-flash"
NEAR_AI_COUNCIL_MODEL="z-ai/glm-5.3-flash"
NEAR_AI_BASE_URL="https://cloud-api.near.ai/v1"
NEAR_AI_TIMEOUT="120"

# Twitter / X API v2 Bearer Token (Optional: for live hashtag sentiment)
TWITTER_BEARER_TOKEN=""
X_BEARER_TOKEN=""

# Server Configuration
PORT=8000
HOST="0.0.0.0"

# Network Configuration (Mainnet prohibited by default)
ENABLE_MAINNET=true
NEAR_NETWORK="mainnet" # Options: "mainnet", "testnet", "betanet", "localnet"

# NEAR Intents / Defuse 1-Click API Partner Key
ONECLICK_JWT=""

# Agent Security & Encryption Key (AES-256 for private keys)
AGENT_ENCRYPTION_KEY=""

# Field-Level Encryption Master Key (HKDF-SHA256 Derivation for Multi-Tenant Encryption)
FERNET_MASTER_KEY=""

# Administrative Safeguards & Data Purge Token
ADMIN_WIPE_TOKEN="neptune_admin_secret_wipe_token_2026"

# Turso libSQL Cloud Persistence (Render Free Tier Durability)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
TURSO_LOCAL_PATH="/tmp/neptune_replica.db"

# Marketplace Configuration
MARKETPLACE_TOKEN_CONTRACT="usdt.tether-token.near"
MARKETPLACE_ORDER_TTL_HOURS=24

# SMTP Email Notification Service (Optional: for alerts when Trader/Rebalancer/Watchdog executes)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Neptune AI"
SMTP_FROM_EMAIL=""
