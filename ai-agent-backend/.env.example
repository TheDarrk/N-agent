# NEAR Cloud AI Configuration
NEAR_AI_API_KEY=""
NEAR_AI_MODEL="z-ai/glm-5.3-flash"
NEAR_AI_BASE_URL="https://cloud-api.near.ai/v1"

# Twitter / X API v2 Bearer Token (Optional: for live hashtag sentiment)
TWITTER_BEARER_TOKEN=""
X_BEARER_TOKEN=""

# Server Configuration
PORT=8000
HOST="0.0.0.0"

# Network Configuration (Mainnet prohibited by default)
ENABLE_MAINNET=true
NEAR_NETWORK="mainnet" # Options: "mainnet", "testnet", "betanet", "localnet"

# SMTP Email Notification Service (Optional: for alerts when Trader/Rebalancer/Watchdog executes)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Neptune AI"
SMTP_FROM_EMAIL=""
